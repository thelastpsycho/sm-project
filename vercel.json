{
    "crons": [
        {
            "path": "/api/cron/notify",
            "schedule": "0 1 * * *"
        },
        {
            "path": "/api/cron/weekly",
            "schedule": "0 0 * * 1"
        }
    ],
    "headers": [
        {
            "source": "/service-worker.js",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/javascript; charset=utf-8"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/((?!.*\\.).*)",
            "destination": "/index.html"
        }
    ]
}