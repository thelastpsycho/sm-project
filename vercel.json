{
    "crons": [
        {
            "path": "/api/cron/notify",
            "schedule": "0 1 * * *"
        },
        {
            "path": "/api/cron/weekly",
            "schedule": "0 0 * * 1"
        }
    ],
    "headers": [
        {
            "source": "/service-worker.js",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/javascript; charset=utf-8"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/mcp/authorize",
            "headers": [
                {
                    "key": "Referrer-Policy",
                    "value": "same-origin"
                },
                {
                    "key": "Cache-Control",
                    "value": "no-store"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/.well-known/oauth-protected-resource/api/mcp",
            "destination": "/api/mcp?oauthRoute=resource"
        },
        {
            "source": "/.well-known/oauth-protected-resource",
            "destination": "/api/mcp?oauthRoute=resource"
        },
        {
            "source": "/.well-known/oauth-authorization-server",
            "destination": "/api/mcp?oauthRoute=metadata"
        },
        {
            "source": "/oauth/authorize",
            "destination": "/api/mcp?oauthRoute=authorize"
        },
        {
            "source": "/oauth/register",
            "destination": "/api/mcp?oauthRoute=register"
        },
        {
            "source": "/oauth/token",
            "destination": "/api/mcp?oauthRoute=token"
        },
        {
            "source": "/oauth/revoke",
            "destination": "/api/mcp?oauthRoute=revoke"
        },
        {
            "source": "/((?!.*\\.).*)",
            "destination": "/index.html"
        }
    ]
}
