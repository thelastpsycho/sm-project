rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to chat settings for everyone
    match /settings/chat {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Role -> route permission matrix. Any signed-in user reads it (to render their
    // nav); only an admin (custom claim) may change it.
    match /settings/rolePermissions {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Custom role definitions (id/label/capabilities). Any signed-in user reads it
    // (to render role names); only an admin may add/edit/delete custom roles.
    match /settings/roles {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Allow read/write access to chat sessions
    match /chatSessions/{sessionId} {
      allow create: if request.auth != null || request.resource.data.roomNumber != null;
      allow read, update: if request.auth != null ||
        resource.data.roomNumber == request.resource.data.roomNumber;
    }

    // Survey collections - allow public access (PIN-based auth in app)
    match /events/{document=**} {
      allow read, write: if true;
    }
    match /responses/{document=**} {
      allow read, write: if true;
    }
    match /adminSettings/{document=**} {
      allow read, write: if true;
    }

    // CRM / Sales pipeline — now gated by Firebase Auth (email/password).
    match /deals/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      // Owner (matched by email), admin, or manager (editAll claim) may edit;
      // unassigned = anyone signed in.
      allow update: if request.auth != null && (
                       request.auth.token.admin == true
                       || request.auth.token.editAll == true
                       || resource.data.ownerId == ''
                       || resource.data.ownerId == request.auth.token.email);
      // Admins and any role granted the `deals:delete` capability (canDelete claim).
      allow delete: if request.auth != null && (
                       request.auth.token.admin == true
                       || request.auth.token.canDelete == true);

      // Everyone signed in can read/add comments; edit/delete own (or admin).
      match /comments/{c} {
        allow read, create: if request.auth != null;
        allow update, delete: if request.auth != null && (
                                 request.auth.token.admin == true
                                 || resource.data.authorId == request.auth.token.email);
      }
    }

    // Append-only pipeline event log (stage transitions) — powers conversion / velocity
    // analytics. Any signed-in user reads and appends; only admins may edit/delete.
    match /pipelineEvents/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Team roster. Read by any signed-in user; a user may update only their own doc
    // (fcmTokens / notificationsSeenAt); create/delete + role/status are admin-only.
    match /users/{uid} {
      allow read:   if request.auth != null;
      // A user may update their own doc (fcmTokens / notificationsSeenAt); an admin
      // may update any user's metadata. Role/status also propagate via the admin API.
      allow update: if request.auth != null &&
                       (request.auth.uid == uid || request.auth.token.admin == true);
      allow create, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Function Chart / venue bookings - public access (PIN-based auth in app).
    match /functions/{document=**} {
      allow read, write: if true;
    }

    // Allow read access to public collections
    match /{collection}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
